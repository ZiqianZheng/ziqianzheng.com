---
/**
 * Shell for every page: the Garden backdrop, fixed HUD furniture, and a slot
 * for real content that scrolls over the top.
 *
 * The scene is decorative. Everything meaningful is ordinary DOM in the slot,
 * so the page works with JavaScript off, without WebGL, and for a crawler.
 */
import BaseHead from '../components/BaseHead.astro';
import Garden from '../components/Garden.astro';
import { profile } from '../data/profile';
import type { SectionKey } from '../scene/palette';
import '../styles/tokens.css';

interface Props {
	title: string;
	description: string;
	section?: SectionKey;
	/** Hide the scene behind a solid panel — used for long-form reading. */
	calm?: boolean;
}
const { title, description, section = 'home', calm = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class={calm ? 'calm' : ''}>
		<Garden section={section} />

		<header class="hud">
			<a class="brand" href="/">
				<span class="brand-name">{profile.name}</span>
				<span class="label brand-role">{profile.role}</span>
			</a>
			<nav aria-label="Sections">
				<a href="/#research">Research</a>
				<a href="/#publications">Publications</a>
				<a href="/blog">Writing</a>
				<a href="/#about">About</a>
			</nav>
		</header>

		<main class="shell">
			<slot />
		</main>

		<footer>
			<p class="label">
				<span class="tick"></span>{profile.name} · {new Date().getFullYear()}
			</p>
			<p class="label">Built with Astro &amp; Three.js</p>
		</footer>

		<style is:global>
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}
			html {
				scroll-behavior: smooth;
			}
			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}
			}
			body {
				margin: 0;
				min-height: 100svh;
				font-family: var(--font-body);
				color: var(--ink);
				line-height: 1.6;
				/* Sits above the fixed canvas, which is at z-index -1. */
				position: relative;
			}
			body.calm::before {
				content: '';
				position: fixed;
				inset: 0;
				z-index: -1;
				background: var(--panel-solid);
				opacity: 0.94;
			}
			a {
				color: inherit;
			}

			h1,
			h2,
			h3 {
				font-family: var(--font-display);
				font-weight: 400;
				line-height: 1.12;
				letter-spacing: -0.005em;
			}

			/*
			 * Class, not element: the Astro blog template's global.css pins
			 * `main` to 720px, and a class selector wins without having to
			 * unpick that stylesheet (the article pages still rely on it).
			 */
			.shell {
				width: auto;
				max-width: 78rem;
				margin: 0 auto;
				padding: 0 var(--gutter);
			}

			/* --- fixed furniture -------------------------------------------- */
			.hud {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 10;
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 1rem;
				padding: var(--gutter);
				pointer-events: none;
			}
			/*
			 * The HUD floats over whatever the scene happens to be showing, which
			 * ranges from bright cream to near-black. A feathered wash behind it
			 * guarantees contrast without drawing a visible bar.
			 */
			.hud::before {
				content: '';
				position: absolute;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				background: linear-gradient(
					180deg,
					rgba(250, 246, 237, 0.82),
					rgba(250, 246, 237, 0) 100%
				);
			}
			.hud a {
				pointer-events: auto;
				text-decoration: none;
			}
			.brand {
				display: flex;
				flex-direction: column;
				line-height: 1.05;
			}
			.brand-name {
				font-family: var(--font-display);
				font-size: 1.05rem;
				letter-spacing: 0.16em;
				text-transform: uppercase;
			}
			.brand-role {
				margin-top: 0.35rem;
			}
			.hud nav {
				display: flex;
				gap: 1.4rem;
				font-family: var(--font-display);
				font-size: 0.6875rem;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				padding-top: 0.2rem;
			}
			.hud nav a {
				padding-bottom: 0.25rem;
				border-bottom: 1px solid transparent;
			}
			.hud nav a:hover {
				border-bottom-color: var(--accent);
			}
			@media (max-width: 34rem) {
				.hud nav {
					gap: 0.9rem;
				}
				.hud nav a:nth-child(3) {
					display: none;
				}
			}

			footer {
				display: flex;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 0.5rem;
				max-width: 78rem;
				margin: 0 auto;
				padding: 4rem var(--gutter) 2.5rem;
			}
		</style>
	</body>
</html>
