---
/**
 * Arrival: the tessellation fills the whole screen.
 *
 * The renderer is a vendored build of tessellation-webgl by Jérémie Piellard
 * (MIT — see /tess/LICENSE and `design/tessellation.md`). It lives in `public/`
 * rather than the Astro pipeline because it is a prebuilt webpack bundle that
 * spawns its own Web Worker, and both need stable, absolute URLs.
 *
 * Load order matters: config.js installs the `Page` global that main.js reads
 * the moment it executes, so neither is deferred and both sit at end of body.
 */
import '../styles/tokens.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>Ziqian Zheng</title>
		<meta
			name="description"
			content="Personal site of Ziqian Zheng — software engineer, PhD in industrial engineering."
		/>
		<link rel="canonical" href="https://www.ziqianzheng.com/" />
		<link rel="icon" href="/avatar.png" />
	</head>
	<body>
		<canvas id="tessellation-canvas" aria-hidden="true"></canvas>

		<!--
			The way in. Hidden until the scene freezes, then a single triangle is
			outlined and named. Purely decorative for assistive tech — the real
			link is the always-present one below, which is also the no-JS path.
		-->
		<div id="gate" hidden>
			<svg id="gate-svg" aria-hidden="true"><polygon id="gate-shape"></polygon></svg>
			<a id="gate-label" href="/about">about me</a>
		</div>

		<!--
			The canvas carries no text, so this is the page's only real content.
			A genuine top-level heading rather than a styled link: it is what a
			crawler and a screen reader have to work with.
		-->
		<header class="mark">
			<h1>Ziqian Zheng</h1>
			<p>a wanderer</p>
			{/* Reachable by keyboard, screen readers, and with JS disabled. */}
			<a class="mark-link" href="/about">about me</a>
		</header>

		<style is:global>
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}
			html,
			body {
				height: 100%;
			}
			body {
				margin: 0;
				/* Shows through before the first frame, and if WebGL is absent. */
				background: var(--sky-far);
				color: var(--bone-light);
				font-family: var(--font-body);
				overflow: hidden;
			}

			#tessellation-canvas {
				position: fixed;
				inset: 0;
				display: block;
				width: 100%;
				height: 100%;
				/* The engine zooms on wheel and drag; let it have the gestures. */
				touch-action: none;
			}
			/* Set by the config shim when WebGL or a shader fails. */
			html.tess-failed #tessellation-canvas {
				display: none;
			}

			.mark {
				position: fixed;
				top: var(--gutter);
				left: var(--gutter);
				z-index: 10;
				font-family: var(--font-display);
				color: var(--bone-light);
				/*
				 * A soft shadow rather than `mix-blend-mode: difference`: against
				 * a field this green, difference turns pale text magenta, which
				 * reads as a mistake. The shadow keeps it legible over both the
				 * bright and the dark greens without shifting hue.
				 */
				text-shadow:
					0 0 2px rgba(12, 26, 16, 0.4),
					0 2px 28px rgba(12, 26, 16, 0.55);
			}
			.mark h1 {
				margin: 0;
				font-size: clamp(1rem, 1.5vw, 1.25rem);
				font-weight: 400;
				letter-spacing: 0.3em;
				text-transform: uppercase;
				line-height: 1.2;
			}
			.mark p {
				margin: 0.7em 0 0;
				font-size: clamp(0.75rem, 1vw, 0.875rem);
				letter-spacing: 0.24em;
				/* Lowercase against the uppercase name — the contrast is what
				   makes a two-line lockup read as one thing. */
				text-transform: lowercase;
				opacity: 0.78;
			}
			/*
			 * Visually hidden but focusable, so the page is navigable by keyboard
			 * and without JavaScript. Becomes visible on focus.
			 */
			.mark-link {
				position: absolute;
				width: 1px;
				height: 1px;
				overflow: hidden;
				clip-path: inset(50%);
				white-space: nowrap;
			}
			.mark-link:focus-visible {
				position: static;
				width: auto;
				height: auto;
				clip-path: none;
				display: inline-block;
				margin-top: 0.9em;
				padding: 0.4em 0.8em;
				border: 1px solid currentColor;
				font-size: 0.75rem;
				letter-spacing: 0.24em;
				text-transform: lowercase;
				color: inherit;
			}

			/* --- the gate ------------------------------------------------- */
			#gate {
				position: fixed;
				inset: 0;
				z-index: 9;
				pointer-events: none;
				opacity: 0;
				transition: opacity 420ms ease;
			}
			#gate.on {
				opacity: 1;
			}
			#gate-svg {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				overflow: visible;
			}
			/*
			 * Blinks between the region's own colour and solid black, rather than
			 * washing it with a tint. Against a field this busy a wash barely
			 * registers; dropping the shape to black is unmistakable, and it keeps
			 * the artwork's own colour as the other half of the blink instead of
			 * covering it up.
			 */
			#gate-shape {
				fill: #000;
				fill-opacity: 0;
				stroke: rgba(250, 244, 229, 0.92);
				stroke-width: 2;
				stroke-linejoin: round;
				paint-order: stroke;
				pointer-events: auto;
				cursor: pointer;
				animation: gate-blink 1.5s ease-in-out infinite;
			}
			@keyframes gate-blink {
				/* Long holds at each end with quick crossings, so it reads as a
				   blink rather than a breath. */
				0%,
				42% {
					fill-opacity: 0;
				}
				50%,
				92% {
					fill-opacity: 0.94;
				}
				100% {
					fill-opacity: 0;
				}
			}
			#gate-label {
				position: absolute;
				transform: translate(-50%, -50%);
				pointer-events: auto;
				cursor: pointer;
				font-family: var(--font-display);
				font-size: clamp(0.8rem, 1.4vw, 1.05rem);
				letter-spacing: 0.3em;
				text-transform: lowercase;
				text-decoration: none;
				color: var(--bone-light);
				text-shadow:
					0 0 3px rgba(12, 26, 16, 0.75),
					0 2px 26px rgba(12, 26, 16, 0.8);
				white-space: nowrap;
			}
			#gate-label::after {
				content: ' →';
				opacity: 0.7;
			}

			@media (prefers-reduced-motion: reduce) {
				#gate {
					transition: none;
				}
				#gate-shape {
					animation: none;
					fill-opacity: 0.55;
				}
			}
		</style>

		<script is:inline src="/tess/config.js"></script>
		<script is:inline src="/tess/main.js"></script>

		<script>
			import { pickRegion, thresholds, type Point } from '../scripts/pick-region';

			type Tessellation = {
				pause(): void;
				resume(): void;
				isPaused(): boolean;
				getCanvas(): HTMLCanvasElement | null;
			};
			const tess = (window as unknown as { tessellation?: Tessellation }).tessellation;

			// Absent in production while the about page is still a draft, so every
			// use below is guarded rather than asserted.
			const gate = document.getElementById('gate');
			const shape = document.getElementById('gate-shape');
			const label = document.getElementById('gate-label') as HTMLAnchorElement | null;
			const canvas = document.getElementById('tessellation-canvas') as HTMLCanvasElement | null;

			/** How long the pointer must be still before the scene resumes. */
			const IDLE_MS = 3000;

			let shown = false;
			let idleTimer: number | undefined;
			/** Where the last offer sat, so the next one lands somewhere else. */
			let lastCentroid: Point | null = null;

			function place() {
				if (!canvas || !tess || !gate || !shape || !label) return;
				const found = pickRegion(canvas, { avoid: lastCentroid });
				// Nothing suitable in this frame — stay frozen and try again on the
				// next pointer move rather than flashing something arbitrary.
				if (!found) return;
				lastCentroid = found.centroid;

				shape.setAttribute('points', found.polygon.map((p) => `${p.x},${p.y}`).join(' '));

				// Keep the label off the very edge, where it would be clipped.
				const pad = 80;
				const x = Math.min(Math.max(found.centroid.x, pad), canvas.clientWidth - pad);
				const y = Math.min(Math.max(found.centroid.y, 40), canvas.clientHeight - 40);
				label.style.left = `${x}px`;
				label.style.top = `${y}px`;

				gate.hidden = false;
				// Next frame, so the transition has a from-state to animate from.
				requestAnimationFrame(() => gate.classList.add('on'));
				shown = true;
			}

			function freeze() {
				if (!tess) return;
				if (!shown) {
					tess.pause();
					// Two frames: one for the engine to render with zoom at zero,
					// one to be sure that frame reached the drawing buffer before
					// we read it back.
					requestAnimationFrame(() => requestAnimationFrame(place));
				}
				window.clearTimeout(idleTimer);
				idleTimer = window.setTimeout(thaw, IDLE_MS);
			}

			function thaw() {
				if (!tess || !gate) return;
				window.clearTimeout(idleTimer);
				gate.classList.remove('on');
				shown = false;
				tess.resume();
				// Leave the node in place until the fade finishes.
				window.setTimeout(() => {
					if (!shown) gate.hidden = true;
				}, 420);
			}

			if (tess && canvas && gate && shape && label) {
				addEventListener('pointermove', freeze, { passive: true });
				addEventListener('pointerdown', freeze, { passive: true });
				// Coordinates are in CSS pixels against the old size, so drop the
				// highlight rather than let it drift off the triangle.
				addEventListener('resize', () => {
					if (shown) thaw();
				});
				shape.addEventListener('click', () => {
					location.href = '/about';
				});
			}

			// Background tabs suspend requestAnimationFrame, so the freeze→place
			// chain cannot run under automated capture. Expose the steps directly.
			if (import.meta.env.DEV) {
				(window as any).__gate = { place, freeze, thaw, pickRegion, thresholds, canvas };
			}
		</script>
	</body>
</html>
