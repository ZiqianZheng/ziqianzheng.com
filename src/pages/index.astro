---
/**
 * Arrival: the tessellation fills the whole screen.
 *
 * The renderer is a vendored build of tessellation-webgl by Jérémie Piellard
 * (MIT — see /tess/LICENSE and `design/tessellation.md`). It lives in `public/`
 * rather than the Astro pipeline because it is a prebuilt webpack bundle that
 * spawns its own Web Worker, and both need stable, absolute URLs.
 *
 * Load order matters: config.js installs the `Page` global that main.js reads
 * the moment it executes, so neither is deferred and both sit at end of body.
 */
import '../styles/tokens.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>Ziqian Zheng</title>
		<meta
			name="description"
			content="Personal site of Ziqian Zheng — software engineer, PhD in industrial engineering."
		/>
		<link rel="canonical" href="https://www.ziqianzheng.com/" />
		<link rel="icon" href="/avatar.png" />
	</head>
	<body>
		<canvas id="tessellation-canvas" aria-hidden="true"></canvas>

		<!--
			The way in. Hidden until the scene freezes, at which point a region
			breaks apart, its pieces fly off screen, and the hole they leave is
			named and clickable. Purely decorative for assistive tech — the real
			link is the always-present one below, which is also the no-JS path.
		-->
		<div id="gate" hidden>
			<svg id="gate-svg" aria-hidden="true">
				<polygon id="gate-shape"></polygon>
				<g id="gate-shards"></g>
			</svg>
			<a id="gate-label" href="/about">about</a>
		</div>

		<!--
			The canvas carries no text, so this is the page's only real content.
			A genuine top-level heading rather than a styled link: it is what a
			crawler and a screen reader have to work with.
		-->
		<header class="mark">
			<h1>Ziqian Zheng</h1>
			<p>a wanderer</p>
			{/* Reachable by keyboard, screen readers, and with JS disabled. */}
			<a class="mark-link" href="/about">about</a>
		</header>

		<style is:global>
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}
			html,
			body {
				height: 100%;
			}
			body {
				margin: 0;
				/* Shows through before the first frame, and if WebGL is absent. */
				background: var(--sky-far);
				color: var(--bone-light);
				font-family: var(--font-body);
				overflow: hidden;
			}

			#tessellation-canvas {
				position: fixed;
				inset: 0;
				display: block;
				width: 100%;
				height: 100%;
				/* The engine zooms on wheel and drag; let it have the gestures. */
				touch-action: none;
			}
			/* Set by the config shim when WebGL or a shader fails. */
			html.tess-failed #tessellation-canvas {
				display: none;
			}

			.mark {
				position: fixed;
				top: var(--gutter);
				left: var(--gutter);
				z-index: 10;
				font-family: var(--font-display);
				color: var(--bone-light);
				/*
				 * A soft shadow rather than `mix-blend-mode: difference`: against
				 * a field this green, difference turns pale text magenta, which
				 * reads as a mistake. The shadow keeps it legible over both the
				 * bright and the dark greens without shifting hue.
				 */
				text-shadow:
					0 0 2px rgba(12, 26, 16, 0.4),
					0 2px 28px rgba(12, 26, 16, 0.55);
			}
			.mark h1 {
				margin: 0;
				font-size: clamp(1rem, 1.5vw, 1.25rem);
				font-weight: 400;
				letter-spacing: 0.3em;
				text-transform: uppercase;
				line-height: 1.2;
			}
			.mark p {
				margin: 0.7em 0 0;
				font-size: clamp(0.75rem, 1vw, 0.875rem);
				letter-spacing: 0.24em;
				/* Lowercase against the uppercase name — the contrast is what
				   makes a two-line lockup read as one thing. */
				text-transform: lowercase;
				opacity: 0.78;
			}
			/*
			 * Visually hidden but focusable, so the page is navigable by keyboard
			 * and without JavaScript. Becomes visible on focus.
			 */
			.mark-link {
				position: absolute;
				width: 1px;
				height: 1px;
				overflow: hidden;
				clip-path: inset(50%);
				white-space: nowrap;
			}
			.mark-link:focus-visible {
				position: static;
				width: auto;
				height: auto;
				clip-path: none;
				display: inline-block;
				margin-top: 0.9em;
				padding: 0.4em 0.8em;
				border: 1px solid currentColor;
				font-size: 0.75rem;
				letter-spacing: 0.24em;
				text-transform: lowercase;
				color: inherit;
			}

			/* --- the gate ------------------------------------------------- */
			#gate {
				position: fixed;
				inset: 0;
				z-index: 9;
				pointer-events: none;
				opacity: 0;
				transition: opacity 420ms ease;
			}
			#gate.on {
				opacity: 1;
			}
			#gate-svg {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				overflow: visible;
			}
			/*
			 * The hole left behind once the pieces detach. Solid black and
			 * unoutlined: the area is not a shape drawn on the artwork, it is
			 * artwork that is no longer there. It also stays put as the click
			 * target long after the debris has gone.
			 */
			#gate-shape {
				fill: #000;
				pointer-events: auto;
				cursor: pointer;
				opacity: 0;
				/* Quick: the moment the pieces detach, nothing is there any more. */
				animation: gate-open 420ms ease-out forwards;
			}
			@keyframes gate-open {
				from {
					opacity: 0;
				}
				to {
					opacity: 1;
				}
			}

			/* Flying pieces. Never clickable — the hole underneath is the target. */
			#gate-shards {
				pointer-events: none;
			}
			.shard {
				/* Rotate about each piece's own centre, not the SVG origin. */
				transform-box: fill-box;
				transform-origin: center;
				/*
				 * A piece cut from the artwork is the same colour as the artwork,
				 * so without an edge it is invisible until it clears the mosaic.
				 * The dark outline separates it the instant it starts moving.
				 */
				stroke: rgba(6, 14, 8, 0.85);
				stroke-width: 1.25;
				stroke-linejoin: round;
			}

			@media (prefers-reduced-motion: reduce) {
				#gate-shape {
					animation: none;
					opacity: 1;
				}
				#gate-shards {
					display: none;
				}
			}
			#gate-label {
				position: absolute;
				transform: translate(-50%, -50%);
				pointer-events: auto;
				cursor: pointer;
				font-family: var(--font-display);
				font-size: clamp(0.8rem, 1.4vw, 1.05rem);
				letter-spacing: 0.3em;
				text-transform: lowercase;
				text-decoration: none;
				color: var(--bone-light);
				text-shadow:
					0 0 3px rgba(12, 26, 16, 0.75),
					0 2px 26px rgba(12, 26, 16, 0.8);
				white-space: nowrap;
			}
			@media (prefers-reduced-motion: reduce) {
				#gate {
					transition: none;
				}
			}
		</style>

		<script is:inline src="/tess/config.js"></script>
		<script is:inline src="/tess/main.js"></script>

		<script>
			import { pickRegion, thresholds, type FoundRegion, type Point } from '../scripts/pick-region';

			type Tessellation = {
				pause(): void;
				resume(): void;
				isPaused(): boolean;
				getCanvas(): HTMLCanvasElement | null;
			};
			const tess = (window as unknown as { tessellation?: Tessellation }).tessellation;

			// Guarded rather than asserted: these were absent in production while
			// the about page was a draft, and the same will apply to the next page
			// built that way.
			const gate = document.getElementById('gate');
			const shape = document.getElementById('gate-shape');
			const shards = document.getElementById('gate-shards');
			const label = document.getElementById('gate-label') as HTMLAnchorElement | null;
			const canvas = document.getElementById('tessellation-canvas') as HTMLCanvasElement | null;

			/** How long the pointer must be still before the scene resumes. */
			const IDLE_MS = 3000;

			/**
			 * Live query, not a one-off read: the setting can change mid-session,
			 * and honouring it matters here because the shatter throws a dozen
			 * spinning shapes across the whole viewport.
			 */
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

			let shown = false;
			let idleTimer: number | undefined;
			/** Where the last offer sat, so the next one lands somewhere else. */
			let lastCentroid: Point | null = null;

			/**
			 * Break the chosen region apart and throw the pieces off screen.
			 *
			 * Each piece carries the colour of the canvas it came from, so what
			 * flies away looks like the artwork itself rather than an overlay, and
			 * what it leaves behind is the dark hole that becomes the way in.
			 *
			 * Direction is outward from the region's centre. Pieces very near that
			 * centre have no meaningful outward direction, so they get a random
			 * one instead of barely moving while everything else clears the frame.
			 */
			function shatter(found: FoundRegion) {
				if (!shards) return;
				shards.replaceChildren();
				if (reduced.matches) return;

				// Far enough that every piece leaves the viewport whatever its
				// starting position.
				const reach = Math.hypot(innerWidth, innerHeight);

				for (const piece of found.shards) {
					const el = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
					el.setAttribute('points', piece.points.map((p) => `${p.x},${p.y}`).join(' '));
					el.setAttribute('fill', piece.color);
					el.classList.add('shard');
					shards.appendChild(el);

					let ax = piece.centroid.x - found.centroid.x;
					let ay = piece.centroid.y - found.centroid.y;
					let len = Math.hypot(ax, ay);
					if (len < 1) {
						const angle = Math.random() * Math.PI * 2;
						ax = Math.cos(angle);
						ay = Math.sin(angle);
						len = 1;
					}
					const distance = reach * (0.8 + Math.random() * 0.5);
					// A slow tumble, not a spin. Debris turns lazily.
					const spin = (Math.random() * 2 - 1) * 110;

					const flight = el.animate(
						[
							{ transform: 'translate(0px, 0px) rotate(0deg)' },
							{
								transform: `translate(${(ax / len) * distance}px, ${(ay / len) * distance}px) rotate(${spin}deg)`,
							},
						],
						{
							duration: 7000 + Math.random() * 4500,
							/*
							 * Linear, deliberately. Every eased curve implies drag,
							 * and this should read as debris in vacuum: struck once,
							 * then coasting at whatever speed the impact gave it.
							 * Ease-out made it look like the pieces were slowing
							 * against air.
							 */
							easing: 'linear',
							// A brief spread, since an impact does not free every
							// piece at the same instant.
							delay: Math.random() * 320,
							fill: 'forwards',
						},
					);

					/*
					 * Each piece owns its own lifetime. The flight now outlasts the
					 * three-second idle timeout by some margin, and cutting the
					 * debris the instant the scene resumed looked like a bug — so
					 * the pieces coast on regardless and retire themselves once they
					 * are past the edge. Starting a new shatter still clears them,
					 * which cancels these and rejects the promise; nothing to do.
					 */
					flight.finished.then(() => el.remove()).catch(() => {});
				}
			}

			function place() {
				if (!canvas || !tess || !gate || !shape || !label) return;
				const found = pickRegion(canvas, { avoid: lastCentroid });
				// Nothing suitable in this frame — stay frozen and try again on the
				// next pointer move rather than flashing something arbitrary.
				if (!found) return;
				lastCentroid = found.centroid;

				shape.setAttribute('points', found.polygon.map((p) => `${p.x},${p.y}`).join(' '));
				shatter(found);

				// Keep the label off the very edge, where it would be clipped.
				const pad = 80;
				const x = Math.min(Math.max(found.centroid.x, pad), canvas.clientWidth - pad);
				const y = Math.min(Math.max(found.centroid.y, 40), canvas.clientHeight - 40);
				label.style.left = `${x}px`;
				label.style.top = `${y}px`;

				gate.hidden = false;
				// Next frame, so the transition has a from-state to animate from.
				requestAnimationFrame(() => gate.classList.add('on'));
				shown = true;
			}

			function freeze() {
				if (!tess) return;
				if (!shown) {
					tess.pause();
					// Two frames: one for the engine to render with zoom at zero,
					// one to be sure that frame reached the drawing buffer before
					// we read it back.
					requestAnimationFrame(() => requestAnimationFrame(place));
				}
				window.clearTimeout(idleTimer);
				idleTimer = window.setTimeout(thaw, IDLE_MS);
			}

			function thaw() {
				if (!tess || !gate) return;
				window.clearTimeout(idleTimer);
				gate.classList.remove('on');
				shown = false;
				tess.resume();
				// Leave the node in place until the fade finishes.
				window.setTimeout(() => {
					if (!shown) gate.hidden = true;
				}, 420);
			}

			if (tess && canvas && gate && shape && label) {
				addEventListener('pointermove', freeze, { passive: true });
				addEventListener('pointerdown', freeze, { passive: true });
				// Coordinates are in CSS pixels against the old size, so drop the
				// highlight rather than let it drift off the triangle.
				addEventListener('resize', () => {
					if (shown) thaw();
				});
				shape.addEventListener('click', () => {
					location.href = '/about';
				});
			}

			// Background tabs suspend requestAnimationFrame, so the freeze→place
			// chain cannot run under automated capture. Expose the steps directly.
			if (import.meta.env.DEV) {
				(window as any).__gate = { place, freeze, thaw, shatter, pickRegion, thresholds, canvas, gate, shape, label };
			}
		</script>
	</body>
</html>
