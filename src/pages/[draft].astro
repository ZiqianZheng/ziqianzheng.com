---
/**
 * Drafts — reachable while developing, never published.
 *
 * `getStaticPaths` returns nothing in a production build, so a draft's URL
 * simply does not exist on the live site; `astro dev` resolves the same
 * function and serves it normally. That keeps work-in-progress pages on `main`,
 * editable and reviewable at localhost, without a branch to remember or a
 * half-finished page appearing on the domain.
 *
 * Currently empty — the about page graduated to `src/pages/`. Kept in place for
 * the pages still to come (research, writing, teaching).
 *
 * To start a draft:
 *   1. put the page in `src/drafts/` (same depth as `src/pages/`, so its
 *      relative imports carry over unchanged);
 *   2. import it here and add it to `drafts` and to `getStaticPaths`;
 *   3. guard any link *to* it with `import.meta.env.DEV`, or the live site
 *      offers a 404.
 *
 * To publish one, undo those three steps.
 *
 * Note that Astro hoists `getStaticPaths` into its own scope, so it cannot read
 * anything declared elsewhere in this frontmatter — slugs must be written out
 * inside it rather than derived from `drafts`.
 */

export function getStaticPaths() {
	if (!import.meta.env.DEV) return [];
	return [] as { params: { draft: string } }[];
}

const drafts: Record<string, never> = {};
const Draft = drafts[Astro.params.draft as string];

if (!Draft) {
	return new Response(null, { status: 404 });
}
---

<Draft />
