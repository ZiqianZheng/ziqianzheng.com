---
/**
 * About.
 *
 * Deliberately calm: no canvas, no motion. The arrival screen carries the
 * spectacle, and this is the page someone reads.
 *
 * Education reads as two lines per entry — the qualification, then where and
 * when — with years rather than months. `profile.ts` keeps the months for the
 * CV; this page does not want that precision.
 */
import { education, links, profile } from '../data/profile';
import '../styles/tokens.css';

/**
 * Years only, and collapsed when a degree begins and ends in the same one —
 * "2023" reads better than "2023–2023". Months are kept in the data for the CV
 * but are more precision than this page wants.
 */
const yearOf = (s: string) => s.match(/\d{4}/)?.[0] ?? '';
function span(from: string, to: string) {
	const a = yearOf(from);
	const b = yearOf(to);
	if (!a || !b) return a || b;
	return a === b ? a : `${a}–${b}`;
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>About — Ziqian Zheng</title>
		<meta name="description" content={profile.intro} />
		<link rel="canonical" href="https://www.ziqianzheng.com/about" />
		<link rel="icon" href="/avatar.png" />
	</head>
	<body>
		<a class="back" href="/">← back</a>

		<main>
			<header>
				<p class="eyebrow">About</p>
				<h1>Ziqian Zheng</h1>
			</header>

			<div class="lede">
				<p>
						I was a software engineer at <a href={profile.org.url}>WeRide</a>. I completed my PhD in
						Industrial Engineering at the{' '}
						<a href="https://www.wisc.edu/">University of Wisconsin–Madison</a>, where I was a member
						of <a href="https://kaibo.ie.wisc.edu/people.html">SIDA</a> under the guidance of Prof.{' '}
						<a href="https://kaibo.ie.wisc.edu/">Kaibo Liu</a>.
					</p>
					<p>
						Before that I received my B.Eng. in Automation at{' '}
						<a href="http://en.xjtu.edu.cn/">Xi'an Jiaotong University</a>, where I was advised by
					Prof. <a href="https://gr.xjtu.edu.cn/en/web/chaoboyan/english">Chao-Bo Yan</a>.
				</p>
			</div>

			<section>
				<h2>Education</h2>
				<ul class="rows">
					{
						education.map((e) => (
							<li>
								<p class="primary">
									{e.degree} in {e.field}
									{e.note && (
										<>
											, {e.note.url ? <a href={e.note.url}>{e.note.label}</a> : e.note.label}
										</>
									)}
								</p>
								<p class="secondary">
									{e.school}
									{e.to && <> · {span(e.from, e.to)}</>}
								</p>
							</li>
						))
					}
				</ul>
			</section>

			<section>
				<h2>Elsewhere</h2>
				<ul class="links">
					<li><a href={links.scholar}>Google Scholar</a></li>
					<li><a href={links.linkedin}>LinkedIn</a></li>
					<li><a href={links.cv}>Curriculum vitae</a></li>
					<li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
				</ul>
			</section>
		</main>

		<footer>
			<p>
				The arrival screen uses{' '}
				<a href="https://github.com/piellardj/tessellation-webgl">tessellation-webgl</a> by Jérémie
				Piellard, used under the MIT licence.
			</p>
		</footer>

		<style is:global>
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				min-height: 100svh;
				background: var(--sky-far);
				color: var(--bone-light);
				font-family: var(--font-body);
				line-height: 1.65;
				/* A quiet echo of the arrival screen's palette, without motion. */
				background-image: radial-gradient(
					120% 80% at 80% -10%,
					rgba(46, 204, 74, 0.16),
					transparent 60%
				);
				background-attachment: fixed;
			}
			a {
				color: inherit;
				text-decoration-color: rgba(250, 244, 229, 0.35);
				text-underline-offset: 0.2em;
			}
			a:hover {
				text-decoration-color: var(--axis-green);
			}

			.back,
			.eyebrow,
			h2,
			footer {
				font-family: var(--font-display);
				letter-spacing: 0.24em;
				text-transform: lowercase;
			}

			.back {
				position: fixed;
				top: var(--gutter);
				left: var(--gutter);
				font-size: 0.75rem;
				text-decoration: none;
				opacity: 0.75;
			}
			.back:hover {
				opacity: 1;
			}

			main {
				max-width: 44rem;
				margin: 0 auto;
				padding: clamp(6rem, 18vh, 11rem) var(--gutter) 3rem;
			}

			.eyebrow {
				margin: 0;
				font-size: 0.6875rem;
				opacity: 0.6;
			}
			h1 {
				font-family: var(--font-display);
				font-weight: 400;
				font-size: clamp(2.2rem, 7vw, 3.4rem);
				letter-spacing: -0.01em;
				margin: 0.25em 0 0.15em;
			}
			.lede {
				margin: clamp(2.5rem, 7vw, 4rem) 0;
				font-size: 1.05rem;
			}
			.lede p {
				margin: 0 0 1em;
			}

			section {
				margin: clamp(2.5rem, 7vw, 4rem) 0;
			}
			h2 {
				font-size: 0.6875rem;
				font-weight: 400;
				opacity: 0.6;
				margin: 0 0 1.2em;
				padding-bottom: 0.9em;
				border-bottom: 1px solid rgba(250, 244, 229, 0.14);
			}

			.rows,
			.links {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.rows li {
				padding: 0.7rem 0;
			}
			.primary {
				margin: 0;
			}
			.secondary {
				margin: 0;
				font-size: 0.9rem;
				opacity: 0.6;
			}

			.links li {
				padding: 0.45rem 0;
			}

			footer {
				max-width: 44rem;
				margin: 0 auto;
				padding: 2rem var(--gutter) 3rem;
				border-top: 1px solid rgba(250, 244, 229, 0.12);
				font-size: 0.625rem;
				opacity: 0.5;
				text-transform: none;
				letter-spacing: 0.08em;
			}
			footer p {
				margin: 0;
			}

		</style>
	</body>
</html>
